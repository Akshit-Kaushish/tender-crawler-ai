# TenderCrawler AI — Environment Configuration
# Copy to .env and fill in values

# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-key

# Redis URL (default: local Docker)
REDIS_URL=redis://redis:6379

# Worker configuration
WORKER_CONCURRENCY=5        # async tasks per worker process
MAX_DEPTH=3                 # max link depth to crawl
DOMAIN_DELAY=0.5            # seconds between requests to same domain

# Output directory (absolute path)
OUTPUT_DIR=/app/output

# Azure Key Vault for protected-source credentials
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/
